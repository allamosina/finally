# Mock API switch (read at build/dev time).
#   unset  -> live API in production builds; in `next dev`, live if /api/health answers, else mocks
#   1      -> always use the in-browser mock API and fake price ticks
#   0      -> always use the live API
NEXT_PUBLIC_MOCK_API=
# `next dev` only: where /api is proxied to.
BACKEND_URL=http://localhost:8000
