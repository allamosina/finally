# FinAlly environment. Copy to .env (gitignored) and edit.
# Docker: passed with `docker run --env-file .env`. Local `uv run` also loads it via python-dotenv.

# OpenRouter API key for live LLM chat. Not needed when LLM_MOCK=true.
# Without a key (and LLM_MOCK not true) the app starts, but POST /api/chat returns 503 "LLM not configured".
OPENROUTER_API_KEY=your-openrouter-api-key-here

# "true" = deterministic mock LLM replies prefixed "[mock] "; never contacts OpenRouter (testing / no key).
LLM_MOCK=false

# Stretch goal: Massive (Polygon.io) API key for real market data.
# Ignored by the core build; the built-in simulator is always used. Leave blank.
MASSIVE_API_KEY=

# Stretch goal (Massive source only): "snapshot" or "eod"; skips the entitlement probe. Blank = auto.
MASSIVE_MODE=

# Stretch goal (Massive source only): seconds between polls. Blank = 15 (snapshot) / 900 (eod).
MASSIVE_POLL_INTERVAL=

# Simulator: integer seed for reproducible price paths (tests). Blank = random.
SIM_SEED=

# Simulator: tick interval in milliseconds. Blank = 500.
SIM_TICK_MS=
